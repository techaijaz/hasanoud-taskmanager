# Copy to .env next to docker-compose.yml and fill in. chmod 600 .env
# DB_HOST, DB_PORT, PORT, NODE_ENV, SERVER_URL and FRONTEND_URL are set by docker-compose.yml.

# Compose project name — keeps container/volume names stable even if the folder moves
COMPOSE_PROJECT_NAME=hasanoud-production
DOMAIN=task.hasanoud.in
# Host port the web container listens on (127.0.0.1 only; host nginx proxies to it)
HTTP_PORT=8100

# Database (created by the mysql container on first start)
DB_NAME=ho-task-manager
DB_USER=hasanoud
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Tokens — long random strings: openssl rand -hex 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Email — EMAIL_PROVIDER: smtp | resend
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@hasanoud.in
SMTP_PASS=
SMTP_FROM="Hasan Oud <noreply@hasanoud.in>"
EMAIL_SERVICE_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Proof uploads — local (stored in ./data/uploads) | cloudinary
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=task-proofs
